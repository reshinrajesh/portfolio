generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// NextAuth Tables (for Passkey & Magic Link)
model User {
  id                String    @id @default(uuid())
  email             String?   @unique
  name              String?
  current_challenge String?   // Used for WebAuthn/Passkeys
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model Authenticator {
  credentialID         String  @id
  userId               String
  providerAccountId    String
  credentialPublicKey  String  // Base64 stored
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  // User relation omitted for simplicity, can link if needed
}

// Blog
model Post {
  id              String   @id @default(uuid())
  title           String
  content         String?
  status          String   @default("Draft") // "Draft" | "Published"
  tags            String[] @default([]) // Assuming Postgres string array mapping
  seo_title       String?
  seo_description String?
  view_count      Int      @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
}

// Skills Gallery
model Skill {
  id         String   @id @default(uuid())
  name       String
  icon       String
  color      String
  order      Int      @default(0)
  created_at DateTime @default(now())
}

// Status History
model StatusIncident {
  id          String   @id @default(uuid())
  title       String
  description String
  status      String   // "Investigating", "Monitoring", "Resolved", "Completed"
  date        DateTime @default(now())
  updates     Json?    // Stores the array of updates
}

// Media / Gallery
model Album {
  id          String         @id @default(uuid())
  title       String
  description String?
  created_at  DateTime       @default(now())
  images      GalleryImage[]
}

model GalleryImage {
  id         String   @id @default(uuid())
  url        String
  name       String
  created_at DateTime @default(now())
  album_id   String?
  album      Album?   @relation(fields: [album_id], references: [id], onDelete: SetNull)
}

// Utilities
model SiteContent {
  id         String   @id @default(uuid())
  key        String   @unique
  value      String
  updated_at DateTime @default(now())
}

model AccessLog {
  id           String   @id @default(uuid())
  created_at   DateTime @default(now())
  status       String   // "SUCCESS" | "FAILURE"
  attempt_code String?
  ip_address   String?
}
